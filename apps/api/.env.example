NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/plataforma_reactivacion?schema=public"

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGIN=http://localhost:8081

# Auth de moderadores (ADMIN)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Rate limiting (por IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Semilla del admin inicial (solo usada por `pnpm seed:admin`, no en el arranque de la app)
ADMIN_EMAIL=moderador@ejemplo.org
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Moderador
